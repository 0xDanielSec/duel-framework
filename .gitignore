# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
.env*

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Output — battle logs and reports are runtime artifacts, not source
output/*.json
output/*.md
output/*.log
output/*.pdf
output/sigma/
output/exports/

# Keep the output directory itself
!output/.gitkeep

# Versioned benchmark results (scaling-law raw data — kept in git on purpose)
!output/benchmarks/
!output/benchmarks/**

# Scratch space — never committed, never leaves the repo either
.tmp/

# Claude Code local config
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ffmpeg.exe
